import lxml.etree as ET

def generate_pmml_check_in_list_arithmetic(var_input_name, var_output_name, var_reference_name, value_list, datatype="string"):
    """
    Generates a PMML transformation to check if a variable is in a predefined list and 
    set the output variable dynamically using arithmetic operations.

    Parameters:
    - var_input_name: Name of the input variable to check.
    - var_output_name: Name of the output variable to set.
    - var_reference_name: Name of the variable to use for dynamic output.
    - value_list: List of allowed values for `var_input_name`.
    - datatype: Data type of the variables (default is "string").

    Returns:
    - PMML string representing the transformation.
    """
    # Root element
    pmml = ET.Element("PMML", version="4.4", xmlns="http://www.dmg.org/PMML-4_4")
    transformation_dict = ET.SubElement(pmml, "TransformationDictionary")
    
    # Derived field for indicator of set membership
    derived_field_in_list = ET.SubElement(
        transformation_dict,
        "DerivedField",
        name=f"{var_input_name}_in_list_flag",
        optype="categorical",
        dataType="integer"
    )
    map_values = ET.SubElement(derived_field_in_list, "MapValues", outputColumn="flag")
    for val in value_list:
        row = ET.SubElement(map_values, "InlineTable", row="row")
        ET.SubElement(row, "input", column="value").text = str(val)
        ET.SubElement(row, "output", column="flag").text = "1"
    # Default to 0 if not in the list
    ET.SubElement(map_values, "DefaultValue").text = "0"
    
    # Derived field for output
    derived_field_output = ET.SubElement(
        transformation_dict,
        "DerivedField",
        name=var_output_name,
        optype="continuous",
        dataType=datatype
    )
    apply_output = ET.SubElement(derived_field_output, "Apply", function="sum")
    
    # var_3 * var_ind_in_list
    apply_product_in_list = ET.SubElement(apply_output, "Apply", function="*")
    ET.SubElement(apply_product_in_list, "FieldRef", field=var_reference_name)
    ET.SubElement(apply_product_in_list, "FieldRef", field=f"{var_input_name}_in_list_flag")
    
    # -1 * (1 - var_ind_in_list)
    apply_negation = ET.SubElement(apply_output, "Apply", function="*")
    ET.SubElement(apply_negation, "Constant", dataType=datatype).text = "-1"
    apply_subtraction = ET.SubElement(apply_negation, "Apply", function="-")
    ET.SubElement(apply_subtraction, "Constant", dataType=datatype).text = "1"
    ET.SubElement(apply_subtraction, "FieldRef", field=f"{var_input_name}_in_list_flag")
    
    # Return the PMML as a string
    return ET.tostring(pmml, pretty_print=True).decode("utf-8")


# Example usage:
var_input = "var_1"
var_output = "var_2"
var_reference = "var_3"
value_list = ["A", "B", "C"]
datatype = "string"

pmml_output = generate_pmml_check_in_list_arithmetic(var_input, var_output, var_reference, value_list, datatype)
print(pmml_output)
