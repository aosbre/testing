def add_transformations_to_local(tree, transformations):
    """
    Adds the given list of transformation elements to the LocalTransformations node at the top.

    Args:
        tree (ET.ElementTree): The XML tree to modify.
        transformations (list of ET.Element): A list of transformation elements to add.

    Returns:
        None: The tree is modified in place.
    """
    # Find the LocalTransformations node
    root = tree.getroot()
    local_transformations = root.find('.//LocalTransformations')

    if local_transformations is None:
        raise ValueError("LocalTransformations node not found in the tree.")

    # Insert the new transformations at the top of LocalTransformations
    for transformation in reversed(transformations):  # Reverse to maintain order at the top
        local_transformations.insert(0, transformation)
